.search-bar-wrap {
  flex: 1;
}

.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 6rpx 12rpx;
  border: 1px solid #b1b1b1;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  background-color: #f5f5f5;
}
